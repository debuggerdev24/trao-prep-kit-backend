PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/prep_kit_db?retryWrites=true&w=majority

# LLM Configuration (OpenAI, OpenRouter, Groq, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
